rules_version = '2';

// AIBF security rules.
// • Anyone can READ public content (site text, events, initiatives, leaders, gallery).
// • Anyone can SUBMIT a membership application, but only in the exact expected shape.
// • Only admins can read applications or change anything.
// • An admin is a signed-in user whose UID has a document in /admins (added by the owner in the Firebase console).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function strMax(v, max) { return v is string && v.size() <= max; }

    function validApplication(d) {
      return d.keys().hasOnly(['name', 'phone', 'email', 'gotra', 'state', 'city', 'interest', 'message', 'tier', 'status', 'createdAt'])
        && d.keys().hasAll(['name', 'phone', 'state', 'city', 'status', 'createdAt'])
        && strMax(d.name, 100) && d.name.size() >= 2
        && d.phone is string && d.phone.matches('^[6-9][0-9]{9}$')
        && strMax(d.state, 60) && d.state.size() > 0
        && strMax(d.city, 80) && d.city.size() > 0
        && (!('email' in d) || strMax(d.email, 120))
        && (!('gotra' in d) || strMax(d.gotra, 60))
        && (!('interest' in d) || strMax(d.interest, 60))
        && (!('message' in d) || strMax(d.message, 1000))
        && (!('tier' in d) || strMax(d.tier, 40))
        && d.status == 'pending'
        && d.createdAt == request.time;
    }

    // Admin list: managed only from the Firebase console. A user may check their own entry.
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Public content, admin-managed.
    match /site/{docId}        { allow read: if true; allow write: if isAdmin(); }
    match /events/{id}         { allow read: if true; allow write: if isAdmin(); }
    match /initiatives/{id}    { allow read: if true; allow write: if isAdmin(); }
    match /leaders/{id}        { allow read: if true; allow write: if isAdmin(); }
    match /gallery/{id}        { allow read: if true; allow write: if isAdmin(); }  // thumbnails
    match /galleryFull/{id}    { allow read: if true; allow write: if isAdmin(); }  // full-size photos
    match /committees/{term}   { allow read: if true; allow write: if isAdmin(); }  // member lists per term (no phone numbers)

    // Membership applications: public can create (validated), admins manage.
    match /applications/{id} {
      allow create: if validApplication(request.resource.data) || isAdmin();
      allow read, update, delete: if isAdmin();
    }

    // Everything else is closed.
    match /{document=**} { allow read, write: if false; }
  }
}
